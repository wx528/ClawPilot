<Window x:Class="ClawPilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClawPilot"
        Width="960" Height="600"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <!-- ComboBox 样式：修复深色主题下拉菜单显示问题 -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#1a2332"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1e2d3a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- 隐形 ToggleButton：负责点击切换下拉 -->
                            <ToggleButton x:Name="ToggleButton"
                                Focusable="false"
                                ClickMode="Press"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Cursor="Hand"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- 主体边框 + 内容 -->
                            <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                IsHitTestVisible="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                        IsHitTestVisible="False"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"/>
                                    <Path x:Name="Arrow"
                                        Grid.Column="1"
                                        Data="M0,0 L4,4 L8,0"
                                        Fill="White"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <!-- 下拉弹出 -->
                            <Popup x:Name="PART_Popup"
                                Placement="Bottom"
                                IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                AllowsTransparency="True"
                                Focusable="False"
                                PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                    Background="#1a2332"
                                    BorderBrush="#1e2d3a"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="2"
                                    MaxHeight="200">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 打开时同步下拉框宽度 = ComboBox 实际宽度 -->
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="DropDownBorder" Property="Width"
                                    Value="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2a3a4a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <!-- ComboBoxItem 样式 -->
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4">
                                    <ContentPresenter
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2a3a4a"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#667EEA"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8a9ba8"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2a3a4a"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#263340"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border x:Name="WindowBorder" CornerRadius="8" Background="#FF1E1E2E" BorderBrush="#40FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border x:Name="TitleBarBorder" Grid.Row="0" Background="#FF1a1a2e" CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🦞 ClawPilot" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AppVersion, StringFormat=' v{0}'}" FontSize="11" Foreground="#7C3AED" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text=" — 多 Agent 统一调度" FontSize="11" Foreground="#8a9ba8" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Daemon 状态指示灯 -->
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#F44336"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDaemonRunning}" Value="True">
                                            <Setter Property="Fill" Value="#4CAF50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding QueueStatusText}" FontSize="11" Foreground="#8a9ba8" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <!-- 自动驾驶状态指示灯 -->
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#555555"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AutopilotVm.IsRunning}" Value="True">
                                            <Setter Property="Fill" Value="#7C3AED"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="自动驾驶" FontSize="11" Foreground="#8a9ba8" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#8a9ba8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AutopilotVm.IsRunning}" Value="True">
                                            <Setter Property="Foreground" Value="#7C3AED"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="—" Background="Transparent" Foreground="#8a9ba8" BorderThickness="0" 
                                FontSize="14" Padding="8,4" Cursor="Hand" Click="Minimize_Click"/>
                        <Button x:Name="MaximizeBtn" Content="□" Background="Transparent" Foreground="#8a9ba8" BorderThickness="0" 
                                FontSize="12" Padding="8,4" Cursor="Hand" Click="Maximize_Click"/>
                        <Button Content="✕" Background="Transparent" Foreground="#8a9ba8" BorderThickness="0" 
                                FontSize="14" Padding="8,4" Cursor="Hand" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主内容区 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 侧边导航栏 -->
                <Border Grid.Column="0" Background="#FF1a1a2e">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <RadioButton x:Name="NavTasks" Content="📋" ToolTip="任务列表" Style="{StaticResource NavButtonStyle}" IsChecked="True" Click="NavTasks_Click"/>
                        <RadioButton x:Name="NavOps" Content="⚡" ToolTip="快捷操作" Style="{StaticResource NavButtonStyle}" Click="NavOps_Click" Margin="0,12,0,0"/>
                        <RadioButton x:Name="NavOrch" Content="🎯" ToolTip="任务编排" Style="{StaticResource NavButtonStyle}" Click="NavOrch_Click" Margin="0,12,0,0"/>
                        <RadioButton x:Name="NavDrafts" Content="📝" ToolTip="编排草案" Style="{StaticResource NavButtonStyle}" Click="NavDrafts_Click" Margin="0,12,0,0"/>
                        <RadioButton x:Name="NavAutopilot" Content="🧠" ToolTip="自动驾驶" Style="{StaticResource NavButtonStyle}" Click="NavAutopilot_Click" Margin="0,12,0,0"/>
                        <RadioButton x:Name="NavSettings" Content="⚙️" ToolTip="设置" Style="{StaticResource NavButtonStyle}" Click="NavSettings_Click" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 内容页 -->
                <Grid Grid.Column="1" Background="#FF1E1E2E">
                    <!-- 任务列表页 -->
                    <Grid x:Name="PageTasks" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧任务列表 -->
                        <Border Grid.Column="0" Background="#FF263340" BorderBrush="#1e2d3a" BorderThickness="0,0,1,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Padding="12,10" Background="#263340">
                                    <StackPanel>
                                        <TextBlock Text="筛选状态" FontSize="11" Foreground="#8a9ba8" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="TaskStatusFilter" FontSize="12" Padding="4,2">
                                            <ComboBoxItem Content="全部" IsSelected="True"/>
                                            <ComboBoxItem Content="pending"/>
                                            <ComboBoxItem Content="running"/>
                                            <ComboBoxItem Content="success"/>
                                            <ComboBoxItem Content="failed"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Padding="12,8" Background="#263340" BorderBrush="#1e2d3a" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TaskItems.Count, FallbackValue=0}" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Text=" 个任务" FontSize="12" Foreground="#8a9ba8" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ListBox Grid.Row="2" x:Name="TaskList" ItemsSource="{Binding TaskItems}" SelectedItem="{Binding SelectedTask}"
                                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#FF9800"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Running"><Setter Property="Fill" Value="#2196F3"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Success"><Setter Property="Fill" Value="#4CAF50"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Fill" Value="#F44336"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayText}" FontSize="13" FontWeight="Medium" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding MessagePreview}" FontSize="11" Foreground="#8a9ba8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border Grid.Row="3" Padding="12,8" Background="#263340">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="刷新" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="12" Padding="8,4" Cursor="Hand" Command="{Binding RefreshCommand}"/>
                                        <Button Content="清除已完成" Background="Transparent" Foreground="#FF9800" BorderThickness="0" FontSize="12" Padding="8,4" Cursor="Hand" Margin="12,0,0,0" Command="{Binding ClearCompletedTasksCommand}"/>
                                        <Button Content="全部清除" Background="Transparent" Foreground="#F44336" BorderThickness="0" FontSize="12" Padding="8,4" Cursor="Hand" Margin="12,0,0,0" Command="{Binding ClearAllTasksCommand}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 右侧任务详情 -->
                        <Grid Grid.Column="1" Background="#FF1E1E2E">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Padding="20,10" BorderBrush="#1e2d3a" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedTask.DisplayText, FallbackValue='选择任务'}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="{Binding SelectedTask.StatusText, FallbackValue=''}" FontSize="12" Foreground="#8a9ba8" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20">
                                <Grid>
                                <StackPanel x:Name="TaskDetailPanel" Visibility="Collapsed">
                                    <Border Background="#263340" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ID" FontSize="12" Foreground="#8a9ba8"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedTask.Id}" FontSize="13" Foreground="White" FontFamily="Consolas, Microsoft YaHei"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Agent" FontSize="12" Foreground="#8a9ba8"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTask.AgentName}" FontSize="13" Foreground="White"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="状态" FontSize="12" Foreground="#8a9ba8"/>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#FF9800"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding SelectedTask.Status}" Value="Running"><Setter Property="Fill" Value="#2196F3"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedTask.Status}" Value="Success"><Setter Property="Fill" Value="#4CAF50"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedTask.Status}" Value="Failed"><Setter Property="Fill" Value="#F44336"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding SelectedTask.StatusText}" FontSize="13" Foreground="White"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="消息" FontSize="12" Foreground="#8a9ba8"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedTask.Message}" FontSize="13" Foreground="White" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="类型" FontSize="12" Foreground="#8a9ba8"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedTask.TaskType}" FontSize="13" Foreground="White" FontFamily="Consolas, Microsoft YaHei"/>
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="来源" FontSize="12" Foreground="#8a9ba8"/>
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedTask.Source}" FontSize="13" Foreground="White" FontFamily="Consolas, Microsoft YaHei"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="#263340" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="任务输出" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                                            <TextBox Text="{Binding SelectedTask.Output, FallbackValue='暂无输出'}" IsReadOnly="True" FontFamily="Consolas, Microsoft YaHei" FontSize="12"
                                                     Background="#1a2332" Foreground="#e0e0e0" BorderBrush="#1e2d3a" BorderThickness="1" Padding="12"
                                                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Height="200"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="删除任务" Background="#F44336" Foreground="White" BorderThickness="0" FontSize="12" Padding="12,8" Cursor="Hand" Command="{Binding DeleteSelectedTaskCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                                <!-- 空状态 -->
                                <StackPanel x:Name="TaskEmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible">
                                    <TextBlock Text="📋" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                    <TextBlock Text="选择左侧任务查看详情" FontSize="13" Foreground="#8a9ba8" HorizontalAlignment="Center"/>
                                </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- 快捷操作页 -->
                    <Grid x:Name="PageOps" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20">
                            <StackPanel>
                                <!-- 添加任务 -->
                                <Border Background="#263340" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="添加任务" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
                                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="执行器" FontSize="12" Foreground="#8a9ba8" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="AddTypeInput" Grid.Column="1" Padding="8,6" FontSize="13" SelectedIndex="{Binding SelectedTaskTypeIndex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkComboBoxStyle}">
                                                <ComboBoxItem Content="OpenClaw"/>
                                                <ComboBoxItem Content="Hermes"/>
                                                <ComboBoxItem Content="KimiCode"/>
                                                <ComboBoxItem Content="CodeBuddy"/>
                                            </ComboBox>
                                        </Grid>
                                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Agent" FontSize="12" Foreground="#8a9ba8" VerticalAlignment="Center"/>
                                            <TextBox x:Name="AddAgentInput" Text="{Binding AgentName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" FontFamily="Consolas, Microsoft YaHei" Grid.Column="1" Background="#1a2332" Foreground="White" BorderBrush="#1e2d3a" BorderThickness="1"/></Grid>
                                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="消息" FontSize="12" Foreground="#8a9ba8" VerticalAlignment="Center"/>
                                            <TextBox x:Name="AddMessageInput" Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" Grid.Column="1" Background="#1a2332" Foreground="White" BorderBrush="#1e2d3a" BorderThickness="1" AcceptsReturn="True" Height="80" TextWrapping="Wrap"/></Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="添加任务" Background="#667EEA" Foreground="White" BorderThickness="0" FontSize="12" Padding="16,8" Cursor="Hand" Command="{Binding AddTaskCommand}" HorizontalAlignment="Left"/>
                                            <TextBlock x:Name="AddResultText" Text="" FontSize="12" Foreground="#8a9ba8" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Text="提示: OpenClaw 需要指定 Agent 名称；Hermes/KimiCode/CodeBuddy 为本地 CLI，Agent 名称可留空" FontSize="11" Foreground="#6a7b88" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <!-- Daemon 控制 -->
                                <Border Background="#263340" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Daemon 控制" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="DaemonStartBtn" Content="启动 Daemon" Background="#4CAF50" Foreground="White" BorderThickness="0" FontSize="12" Padding="12,8" Cursor="Hand" Command="{Binding ToggleDaemonCommand}"/>
                                            <Button x:Name="DaemonStopBtn" Content="停止 Daemon" Background="#F44336" Foreground="White" BorderThickness="0" FontSize="12" Padding="12,8" Cursor="Hand" Margin="8,0,0,0" Command="{Binding ToggleDaemonCommand}"/>
                                            <Button Content="执行一个任务" Background="#607D8B" Foreground="White" BorderThickness="0" FontSize="12" Padding="12,8" Cursor="Hand" Margin="8,0,0,0" Command="{Binding RunTaskOnceCommand}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DaemonControlResult" Text="" FontSize="12" Foreground="#8a9ba8" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <!-- 执行器状态 -->
                                <Border Background="#263340" CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="执行器状态" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="OpenClaw" FontSize="12" Foreground="White" FontWeight="Medium"/>
                                                </StackPanel>
                                                <TextBlock Text="远程 API 调用" FontSize="11" Foreground="#8a9ba8" Margin="14,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Hermes" FontSize="12" Foreground="White" FontWeight="Medium"/>
                                                </StackPanel>
                                                <TextBlock Text="本地 PowerShell 脚本" FontSize="11" Foreground="#8a9ba8" Margin="14,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="#FF9800" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="KimiCode" FontSize="12" Foreground="White" FontWeight="Medium"/>
                                                </StackPanel>
                                                <TextBlock Text="月之暗面本地 CLI" FontSize="11" Foreground="#8a9ba8" Margin="14,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="#FF9800" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="CodeBuddy" FontSize="12" Foreground="White" FontWeight="Medium"/>
                                                </StackPanel>
                                                <TextBlock Text="腾讯 AI 编程助手 CLI" FontSize="11" Foreground="#8a9ba8" Margin="14,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 编排页 -->
                    <Grid x:Name="PageOrchestrator" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20">
                            <StackPanel>
                                <Border Background="#263340" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="快捷操作" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="加载配置文件" Background="#4CAF50" Foreground="White" BorderThickness="0" FontSize="12" Padding="12,8" Cursor="Hand" Command="{Binding LoadConfigFromFileCommand}"/>
                                            <Button Content="执行编排周期" Background="#667EEA" Foreground="White" BorderThickness="0" FontSize="12" Padding="12,8" Cursor="Hand" Margin="8,0,0,0" Command="{Binding ToggleOrchestratorCommand}"/>
                                            <Button Content="刷新全部" Background="#607D8B" Foreground="White" BorderThickness="0" FontSize="12" Padding="12,8" Cursor="Hand" Margin="8,0,0,0" Command="{Binding RefreshCommand}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="OrchResultText" Text="" FontSize="12" Foreground="#8a9ba8" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <!-- 资源概览 -->
                                <Border Background="#263340" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="资源概览" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="活跃 Persona" FontSize="12" Foreground="#8a9ba8" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="DashActivePersonas" Text="--" FontSize="28" FontWeight="Light" Foreground="#667EEA"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="活跃计划" FontSize="12" Foreground="#8a9ba8" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="DashActivePlans" Text="--" FontSize="28" FontWeight="Light" Foreground="#4CAF50"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 草案页 -->
                    <Grid x:Name="PageDrafts" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📝" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="草案功能开发中..." FontSize="14" Foreground="#8a9ba8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- 自动驾驶页 -->
                    <Grid x:Name="PageAutopilot" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20">
                            <StackPanel>
                                <!-- 编排者 Tab 栏 -->
                                <Border Background="#263340" CornerRadius="8,8,0,0" Padding="12,8" Margin="0,0,0,0" BorderBrush="#1e2d3a" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Tab 按钮 - 使用 ListBox 做横向 Tab -->
                                        <ListBox Grid.Column="0" x:Name="PresetTabList"
                                                 ItemsSource="{Binding AutopilotVm.Presets}"
                                                 SelectedIndex="{Binding AutopilotVm.SelectedPresetIndex, Mode=TwoWay}"
                                                 SelectionChanged="PresetTabList_SelectionChanged"
                                                 BorderThickness="0" Background="Transparent"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Background" Value="#1a2332"/>
                                                    <Setter Property="Foreground" Value="#8a9ba8"/>
                                                    <Setter Property="Padding" Value="12,6"/>
                                                    <Setter Property="Margin" Value="0,0,2,0"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}" Cursor="Hand">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#2a3a4a"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#3a4a5a"/>
                                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#667EEA"/>
                                                                        <Setter TargetName="Bd" Property="BorderThickness" Value="0,2,0,0"/>
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                        <!-- 添加/删除预设 -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="+" Background="Transparent" Foreground="#8a9ba8" BorderThickness="0" FontSize="16" Padding="6,2" Cursor="Hand" Command="{Binding AutopilotVm.AddPresetCommand}" ToolTip="添加编排者"/>
                                            <Button Content="✕" Background="Transparent" Foreground="#F44336" BorderThickness="0" FontSize="12" Padding="6,2" Cursor="Hand" Margin="4,0,0,0" Command="{Binding AutopilotVm.RemovePresetCommand}" ToolTip="删除当前编排者"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 控制栏 -->
                                <Border Background="#263340" CornerRadius="0,0,8,8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="启动自动驾驶" Background="#4CAF50" Foreground="White" BorderThickness="0" FontSize="13" Padding="16,10" Cursor="Hand" Command="{Binding AutopilotVm.ToggleAutopilotCommand}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AutopilotVm.IsRunning}" Value="True">
                                                                <Setter Property="Content" Value="停止自动驾驶"/>
                                                                <Setter Property="Background" Value="#F44336"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="立即唤醒" Background="#7C3AED" Foreground="White" BorderThickness="0" FontSize="13" Padding="16,10" Cursor="Hand" Margin="12,0,0,0" Command="{Binding AutopilotVm.TriggerNowCommand}"/>
                                            <Button Content="刷新状态" Background="#607D8B" Foreground="White" BorderThickness="0" FontSize="13" Padding="16,10" Cursor="Hand" Margin="12,0,0,0" Command="{Binding AutopilotVm.RefreshStatusCommand}"/>
                                            <!-- 当前编排者名称 -->
                                            <Border Background="#1a2332" CornerRadius="4" Padding="10,6" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding AutopilotVm.SelectedPreset.Icon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding AutopilotVm.SelectedPreset.DisplayName}" FontSize="13" Foreground="#667EEA" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                                            <TextBlock Text="编排间隔" FontSize="12" Foreground="#8a9ba8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Text="{Binding AutopilotVm.IntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="6,4" FontSize="13" FontFamily="Consolas, Microsoft YaHei" Background="#1a2332" Foreground="White" BorderBrush="#1e2d3a" BorderThickness="1" HorizontalContentAlignment="Center" IsEnabled="{Binding AutopilotVm.IsIntervalEditable}"/>
                                            <TextBlock Text="分钟" FontSize="12" Foreground="#8a9ba8" VerticalAlignment="Center" Margin="4,0,8,0"/>
                                            <CheckBox Content="让编排者自主决定" IsChecked="{Binding AutopilotVm.AdaptiveIntervalEnabled}" FontSize="12" Foreground="#8a9ba8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Button Content="更新配置" Background="#607D8B" Foreground="White" BorderThickness="0" FontSize="12" Padding="10,6" Cursor="Hand" Command="{Binding AutopilotVm.UpdateIntervalCommand}"/>
                                            <TextBlock Text="⚠ 配置已修改，点击更新配置后生效" FontSize="11" Foreground="#F44336" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding AutopilotVm.IsConfigDirty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                                            <TextBlock Text="编排模式" FontSize="12" Foreground="#8a9ba8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox SelectedIndex="{Binding AutopilotVm.SelectedMode, UpdateSourceTrigger=PropertyChanged}" Width="150" Padding="6,4" FontSize="13" Style="{StaticResource DarkComboBoxStyle}">
                                                <ComboBoxItem Content="Plan &amp; Execute"/>
                                                <ComboBoxItem Content="ReAct"/>
                                            </ComboBox>
                                            <TextBlock Text="ReAct: 任务完成即触发下一轮" FontSize="11" Foreground="#6a7b88" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                                            <TextBlock Text="执行器类型" FontSize="12" Foreground="#8a9ba8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="ExecutorTypeCombo" SelectedIndex="{Binding AutopilotVm.SelectedExecutorType, UpdateSourceTrigger=PropertyChanged}" Width="120" Padding="6,4" FontSize="13" Style="{StaticResource DarkComboBoxStyle}" IsEnabled="{Binding AutopilotVm.IsExecutorTypeEditable}">
                                                <ComboBoxItem Content="OpenClaw"/>
                                                <ComboBoxItem Content="Hermes"/>
                                                <ComboBoxItem Content="KimiCode"/>
                                                <ComboBoxItem Content="CodeBuddy"/>
                                            </ComboBox>
                                            <CheckBox x:Name="ExecutorAutoCheckBox" Content="让编排者自主决定" IsChecked="{Binding AutopilotVm.IsExecutorAuto}" FontSize="12" Foreground="#8a9ba8" VerticalAlignment="Center" Margin="8,0,0,0" Checked="ExecutorAutoCheckBox_Changed" Unchecked="ExecutorAutoCheckBox_Changed"/>
                                            <TextBlock x:Name="HermesAgentHint" Text="(本地 Hermes Agent，无需指定代理)" FontSize="11" Foreground="#6a7b88" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"/>
                                            <TextBlock x:Name="OpenClawAgentHint" Text="编排产生的任务将使用此执行者名称" FontSize="11" Foreground="#6a7b88" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel x:Name="AgentNamePanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                                            <TextBlock Text="代理名称" FontSize="12" Foreground="#8a9ba8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Text="{Binding AutopilotVm.AgentName, UpdateSourceTrigger=PropertyChanged}" Width="120" Padding="6,4" FontSize="13" FontFamily="Consolas, Microsoft YaHei" Background="#1a2332" Foreground="White" BorderBrush="#1e2d3a" BorderThickness="1"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding AutopilotVm.StatusMessage}" FontSize="12" Foreground="#8a9ba8" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding AutopilotVm.LastError}" FontSize="12" Foreground="#F44336" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="{Binding AutopilotVm.LastError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- 状态卡片 -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#263340" CornerRadius="8" Padding="16" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="运行时长" FontSize="11" Foreground="#8a9ba8" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding AutopilotVm.ElapsedText}" FontSize="22" FontWeight="SemiBold" Foreground="#7C3AED"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#263340" CornerRadius="8" Padding="16" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="上次唤醒" FontSize="11" Foreground="#8a9ba8" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding AutopilotVm.LastRunText}" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#263340" CornerRadius="8" Padding="16" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="下次唤醒" FontSize="11" Foreground="#8a9ba8" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding AutopilotVm.NextRunText}" FontSize="22" FontWeight="SemiBold" Foreground="#667EEA"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Background="#263340" CornerRadius="8" Padding="16" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="总任务数" FontSize="11" Foreground="#8a9ba8" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding AutopilotVm.TotalTasksScheduled}" FontSize="22" FontWeight="SemiBold" Foreground="#4CAF50"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 目标卡片 -->
                                <Border Background="#263340" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                            <TextBlock Text="🎯 当前目标" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                            <Button Content="编辑" Background="Transparent" Foreground="#667EEA" BorderThickness="0" FontSize="12" Padding="8,2" Cursor="Hand" Margin="12,0,0,0" Command="{Binding AutopilotVm.EditGoalCommand}"/>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding AutopilotVm.IsGoalEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBox Text="{Binding AutopilotVm.GoalTitle, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Background="#1a2332" Foreground="White" BorderBrush="#1e2d3a" BorderThickness="1" Padding="8,6" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                            <TextBox Text="{Binding AutopilotVm.GoalDescription, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Background="#1a2332" Foreground="#e0e0e0" BorderBrush="#1e2d3a" BorderThickness="1" Padding="8,6" Margin="0,0,0,8" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="保存" Background="#4CAF50" Foreground="White" BorderThickness="0" FontSize="12" Padding="12,6" Cursor="Hand" Command="{Binding AutopilotVm.SaveGoalCommand}"/>
                                                <Button Content="取消" Background="Transparent" Foreground="#8a9ba8" BorderThickness="0" FontSize="12" Padding="12,6" Cursor="Hand" Margin="8,0,0,0" Command="{Binding AutopilotVm.CancelEditGoalCommand}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding AutopilotVm.IsGoalEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding AutopilotVm.GoalTitle}" FontSize="14" FontWeight="Medium" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding AutopilotVm.GoalDescription}" FontSize="12" Foreground="#8a9ba8" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 编排者人格 Prompt -->
                                <Border Background="#263340" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="🎭 编排者人格" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                                        <TextBlock Text="定义编排者的角色、关注点和策略，影响 LLM 的编排决策" FontSize="11" Foreground="#6a7b88" Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding AutopilotVm.PresetPersonaPrompt, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Background="#1a2332" Foreground="#e0e0e0" BorderBrush="#1e2d3a" BorderThickness="1" Padding="12" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </Border>

                                <!-- 白板 + 历史 分栏 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 白板 -->
                                    <Border Grid.Column="0" Background="#263340" CornerRadius="8" Padding="16" Margin="0,0,6,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                                <TextBlock Text="📝 白板记忆" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                <Button Content="保存" Background="Transparent" Foreground="#4CAF50" BorderThickness="0" FontSize="12" Padding="8,2" Cursor="Hand" Margin="12,0,0,0" Command="{Binding AutopilotVm.SaveWhiteboardCommand}"/>
                                            </StackPanel>
                                            <TextBox Text="{Binding AutopilotVm.WhiteboardContent, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Background="#1a2332" Foreground="#e0e0e0" BorderBrush="#1e2d3a" BorderThickness="1" Padding="12" Height="300" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- 编排历史 -->
                                    <Border Grid.Column="1" Background="#263340" CornerRadius="8" Padding="16" Margin="6,0,0,0" MaxHeight="420">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="📜 编排历史" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                                            <ListBox Grid.Row="1" ItemsSource="{Binding AutopilotVm.Sessions}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1a2332" CornerRadius="6" Padding="10" Margin="0,4" Width="360">
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding TriggeredAt}" FontSize="11" Foreground="#667EEA" FontFamily="Consolas, Microsoft YaHei"/>
                                                                    <TextBlock Text="[" FontSize="11" Foreground="#8a9ba8" Margin="8,0,0,0"/>
                                                                    <TextBlock Text="{Binding TasksScheduled}" FontSize="11" Foreground="#4CAF50"/>
                                                                    <TextBlock Text=" tasks" FontSize="11" Foreground="#8a9ba8"/>
                                                                    <TextBlock Text="]" FontSize="11" Foreground="#8a9ba8"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding DecisionSummary}" FontSize="12" Foreground="#e0e0e0" TextWrapping="Wrap" Margin="0,4,0,0" MaxHeight="60" TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.ToolTip>
                                                                        <TextBlock Text="{Binding DecisionSummary}" TextWrapping="Wrap" MaxWidth="400" Foreground="Black"/>
                                                                    </TextBlock.ToolTip>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#8a9ba8" Margin="0,4,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="failed">
                                                                                    <Setter Property="Foreground" Value="#F44336"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 设置页 -->
                    <Grid x:Name="PageSettings" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20">
                            <StackPanel>
                                <Border Background="#263340" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="LLM Provider 配置" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="API Key" FontSize="12" Foreground="#8a9ba8" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding LlmApiKey, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Padding="8,6" FontSize="13" FontFamily="Consolas, Microsoft YaHei" Background="#1a2332" Foreground="White" BorderBrush="#1e2d3a" BorderThickness="1"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Base URL" FontSize="12" Foreground="#8a9ba8" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding LlmBaseUrl, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Padding="8,6" FontSize="13" FontFamily="Consolas, Microsoft YaHei" Background="#1a2332" Foreground="White" BorderBrush="#1e2d3a" BorderThickness="1"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Model" FontSize="12" Foreground="#8a9ba8" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding LlmModel, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Padding="8,6" FontSize="13" FontFamily="Consolas, Microsoft YaHei" Background="#1a2332" Foreground="White" BorderBrush="#1e2d3a" BorderThickness="1"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="超时(秒)" FontSize="12" Foreground="#8a9ba8" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding OpenClawTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Padding="8,6" FontSize="13" FontFamily="Consolas, Microsoft YaHei" Background="#1a2332" Foreground="White" BorderBrush="#1e2d3a" BorderThickness="1"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="并发数" FontSize="12" Foreground="#8a9ba8" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding DaemonMaxConcurrency, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Padding="8,6" FontSize="13" FontFamily="Consolas, Microsoft YaHei" Background="#1a2332" Foreground="White" BorderBrush="#1e2d3a" BorderThickness="1"/>
                                        </Grid>
                                        <TextBlock Text="配置保存在本地 settings.json 中，并发数保存后立即生效。" FontSize="11" Foreground="#8a9ba8" Margin="0,0,0,8"/>
                                        <Button Content="保存配置" Background="#4CAF50" Foreground="White" BorderThickness="0" FontSize="12" Padding="12,8" Cursor="Hand" Command="{Binding SaveLlmSettingsCommand}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#263340" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="关于 ClawPilot" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
                                        <TextBlock Text="🦞 ClawPilot — 多 Agent 统一调度平台" FontSize="13" Foreground="White" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding AppVersion, StringFormat='版本: {0}'}" FontSize="12" Foreground="#8a9ba8" Margin="0,0,0,4"/>
                                        <TextBlock Text="数据目录:" FontSize="12" Foreground="#8a9ba8" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding DataDirPath}" FontSize="12" Foreground="#667EEA" FontFamily="Consolas, Microsoft YaHei" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#263340" CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="统计信息" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock x:Name="StatPending" Text="--" FontSize="28" FontWeight="Light" Foreground="#FF9800" HorizontalAlignment="Center"/>
                                                <TextBlock Text="等待中" FontSize="11" Foreground="#8a9ba8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                <TextBlock x:Name="StatRunning" Text="--" FontSize="28" FontWeight="Light" Foreground="#2196F3" HorizontalAlignment="Center"/>
                                                <TextBlock Text="执行中" FontSize="11" Foreground="#8a9ba8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                <TextBlock x:Name="StatSuccess" Text="--" FontSize="28" FontWeight="Light" Foreground="#4CAF50" HorizontalAlignment="Center"/>
                                                <TextBlock Text="已完成" FontSize="11" Foreground="#8a9ba8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                                <TextBlock x:Name="StatFailed" Text="--" FontSize="28" FontWeight="Light" Foreground="#F44336" HorizontalAlignment="Center"/>
                                                <TextBlock Text="已失败" FontSize="11" Foreground="#8a9ba8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
